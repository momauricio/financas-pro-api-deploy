# Environment for financas-pro-api
# Copy to .env (gitignored). Never commit real secrets.

NODE_ENV=production
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# Comma-separated front-end origins
CORS_ORIGIN=https://YOUR_FRONTEND_HOST,http://localhost:5173

# Supabase Postgres via transaction pooler
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&sslmode=require

# Supabase Auth
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# OPTIONAL — only if using legacy HS256 JWT secret
# SUPABASE_JWT_SECRET=

# Optional: B3 quotes via brapi (server-side only — never VITE_*)
# BRAPI_TOKEN=

# Optional: skip JWT crypto in local unit tests only
# AUTH_BYPASS_FOR_TESTS=false
